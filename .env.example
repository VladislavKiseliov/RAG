# Security
HF_TOKEN="your_huggingface_api_key_here"
GEMINI_API_KEY="your_google_api_key_here"
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Postgres)
POSTGRES_DB=myapp_db
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_PORT=5432
DATABASE_URL="postgresql+psycopg2://myuser:mypassword@localhost:5432/myapp_db"
DATABASE_URL_DOCKER="postgresql+psycopg2://myuser:mypassword@postgres:5432/myapp_db"

# Redis
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# Qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL="http://localhost:6333"

# App
DEBUG=true
LOG_LEVEL="INFO"
DOCS_DIRECTORY="./docs"
INGESTION_SERVICE_URL="http://localhost:8001"
INGESTION_SERVICE_URL_DOCKER="http://ingestion-api:8001"

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
INGESTION_PORT=8001
FLOWER_PORT=5555
CELERY_CONCURRENCY=4

# Legacy / optional
SQLITE="./storage/db_chat/tables.db"
