# ═══════════════════════════════════════════════════════════════
#  RAGProgramm — единый файл конфигурации
#  Скопируйте в .env и заполните реальными значениями
# ═══════════════════════════════════════════════════════════════

# ── Общее ────────────────────────────────────────────────────
MODE=DEV
LOG_LEVEL=INFO
DEBUG=false

# ── Порты ────────────────────────────────────────────────────
BACKEND_PORT=8000
RAG_SERVICE_PORT=8001
LLM_SERVICE_PORT=8002
FRONTEND_PORT=5173
ADMIN_PANEL_PORT=5174
FLOWER_PORT=5555

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=myapp_db
POSTGRES_USER=myuser
POSTGRES_PASSWORD=your_postgres_password  # ⬅ заполнить
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_INITDB_ARGS=--encoding=UTF8
# Используется сервисами напрямую (pydantic-settings)
DB_HOST=postgres
DB_PORT=5432
DB_USER=myuser
DB_PASS=your_postgres_password  # ⬅ то же что POSTGRES_PASSWORD
DB_NAME=myapp_db
# Тестовая БД (локальный запуск)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=myuser
TEST_DB_PASS=your_postgres_password  # ⬅ то же что POSTGRES_PASSWORD
TEST_DB_NAME=test_myapp_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_CONCURRENCY=4

# ── Qdrant ────────────────────────────────────────────────────
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
COLLECTION_NAME=rag_documents_collection_with_sparse_vector

# ── MinIO ─────────────────────────────────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=your_minio_access_key  # ⬅ заполнить
MINIO_SECRET_KEY=your_minio_secret_key  # ⬅ заполнить
MINIO_BUCKET=rag-documents
MINIO_SECURE=false
MINIO_PRIVATE_URL=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_URL=http://minio:9000
MINIO_NOTIFY_WEBHOOK_ENABLE_1=on
MINIO_NOTIFY_WEBHOOK_ENDPOINT_1=http://host.docker.internal:8001/documents/ingest/webhook
MINIO_NOTIFY_WEBHOOK_AUTH_TOKEN_1=your_webhook_token  # ⬅ заполнить (любая строка, совпадает с rag_service)

# rag_service -> backend, POST /internal/notes/{id}/index-complete
INTERNAL_WEBHOOK_TOKEN=your_internal_webhook_token  # ⬅ заполнить (любая строка, совпадает в обоих сервисах)

# ── Auth (backend) ────────────────────────────────────────────
SECRET_KEY=your_secret_key_here  # ⬅ заполнить: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Внутренние URL сервисов (Docker-сеть) ─────────────────────
RAG_SERVICE_URL=http://rag-service:8001
RAG_SERVICE_URL_DOCKER=http://rag-service:8001
LLM_SERVICE_URL=http://llm-service:8002
LLM_SERVICE_URL_DOCKER=http://llm-service:8002
# Выключатель авто/ручного саммари документов (POST /documents/{id}/summarize и триггер
# после ingest). По умолчанию включено; выключать временно на время массовой переиндексации.
ENABLE_DOCUMENT_SUMMARIZATION=true

# ── Embeddings (rag_service) ──────────────────────────────────
HF_TOKEN=your_huggingface_token_here  # ⬅ заполнить: https://huggingface.co/settings/tokens
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
EMBEDDING_BATCH_SIZE=64
TEI_URL=http://tei:80
DOCLING_DEVICE=cuda  # cpu | cuda | mps | xpu | auto — GPU для layout/OCR/table-моделей Docling (не эмбеддинги, те через TEI)

# ── LLM (llm_service) ────────────────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b:groq
LLM_API_KEY=your_llm_api_key_here  # ⬅ заполнить: API-ключ провайдера
LLM_BASE_URL=https://your_llm_base_url/v1  # ⬅ заполнить: base URL провайдера (OpenAI-совместимый)
LLM_RAG_TIMEOUT=30.0
LLM_MAX_CONTEXT_CHARS=12000
ML_ROUTER_MODEL_PATH=llm_service/ml_router/intent_model.pkl
ML_ROUTER_CONFIDENCE_THRESHOLD=0.5

# ── Reranker (llm_service, TEI второй контейнер, tei-reranker) ──────────────
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_PORT=8086
RERANKER_TEI_URL=http://tei-reranker:80
LLM_RERANK_TIMEOUT=30.0

# ── Frontend ──────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
