# RAG service environment
# Copy to .env and fill real values. Do not commit .env with secrets.

# Database (asyncpg). If RAG_DATABASE_URL is set, it overrides DATABASE_URL.
# Example: postgresql+asyncpg://user:pass@localhost:5432/rag_db
RAG_DATABASE_URL=
DATABASE_URL=

# Vector DB (Qdrant)
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=rag_documents_collection
QDRANT_MAX_RETRIES=3
QDRANT_RETRY_BACKOFF=0.5
QDRANT_UPSERT_BATCH_SIZE=64

# Qdrant index/optimizers (optional)
QDRANT_HNSW_M=
QDRANT_HNSW_EF_CONSTRUCT=
QDRANT_OPTIMIZERS_DEFAULT_SEGMENT_NUMBER=
QDRANT_OPTIMIZERS_MEMMAP_THRESHOLD=
QDRANT_OPTIMIZERS_INDEXING_THRESHOLD=
QDRANT_WAL_CAPACITY_MB=

# Embeddings (HuggingFace Inference API)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
HF_TOKEN=
EMBEDDING_BATCH_SIZE=64

# LLM API (used by /rag/answer)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_API_TIMEOUT=60
