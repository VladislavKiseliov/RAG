# Document/RAG service env (rename to .env when ready)

# Required keys
GEMINI_API_KEY=your_gemini_api_key_here
HF_TOKEN=your_huggingface_token_here

# LLM/Embeddings models
LLM_MODEL_NAME=models/gemini-2.5-flash-lite
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# Proxy (use your local VPN/proxy endpoint)
HTTP_PROXY=http://127.0.0.1:12334
HTTPS_PROXY=http://127.0.0.1:12334
NO_PROXY=localhost,127.0.0.1,qdrant,redis

# Service infra
DOCS_DIRECTORY=./docs
QDRANT_URL=http://localhost:6333
QDRANT_PATH=./qdrant_storage
REDIS_URL=redis://localhost:6379/0
COLLECTION_NAME=rag_documents_collection
